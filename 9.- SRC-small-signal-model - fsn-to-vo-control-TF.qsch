  «text (-1800,-6050) 1 7 0 0x1000000 -1 -1 "ï»¿.param a51=ks*rc1/(Cf*rc) a52=kc*rc1/(Cf*rc) a53=0 a54=0 a55=-rc1/(R*Cf*rc) b51=0 b52=0 b53=0 b54=rc1/(Cf*rc)"»
  «text (-2300,1350) 2 7 1 0x1000000 -1 -1 "ï»¿.STATE VARIABLES"»
