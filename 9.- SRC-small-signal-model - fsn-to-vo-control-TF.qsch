  «text (8450,-6150) 1 7 0 0x1000000 -1 -1 "ï»¿.param c21=(2/pi)*sin(pi*D/2) c22=0 c23=0 c24=0 c25=0 e21=0 e22=Id e23=0 e24=0"»
  «text (7750,-1400) 2 7 1 0x1000000 -1 -1 "ï»¿.INPUTS"»
  «text (7700,2850) 2 7 1 0x1000000 -1 -1 "ï»¿.PARAMETERS"»
  «text (7700,2500) 1 7 0 0x1000000 -1 -1 "ï»¿.param kv=(4/pi)*sin(pi*D/2) Ed=2*Vg*cos(pi*D/2) Es=Wo*L*Ic Ec=Wo*L*Is"»
  «text (7700,2150) 1 7 0 0x1000000 -1 -1 "ï»¿.param Zs=Ws*L + Re*(a*b)/(a**2 + b**2) Zc=Ws*L - Re*(a*b)/(a**2 + b**2)"»
  «text (7700,1800) 1 7 0 0x1000000 -1 -1 "ï»¿.param G=Ws*C ks=2*Is/(pi*Ip) kc=2*Ic/(pi*Ip) Js=Wo*C*Vc Jc=Wo*C*Vs"»
  «text (7700,1450) 1 7 0 0x1000000 -1 -1 "ï»¿.param Rsx= rs + Re*(a**2)/(a**2 + b**2) Rcx= rs + Re*(b**2)/(a**2 + b**2) "»
  «text (7700,1100) 1 7 0 0x1000000 -1 -1 "ï»¿.param Id=Is*cos(pi*D/2) a=1-Ws**2*L*C b=Ws*C*(Re+rs)"»
  «text (7700,800) 1 7 0 0x1000000 -1 -1 "ï»¿.param Re=(8/pi**2)*(1-rc1/R)*rc*R/rc1 rc1=rc*R/(rc+R) Ve=(4*Vg/pi)*sin(pi*D/2)"»
  «text (7750,300) 2 7 1 0x1000000 -1 -1 "ï»¿.STEADY-STATE OPERATING POINT"»
  «text (7750,-150) 1 7 0 0x1000000 -1 -1 "ï»¿.param Is=Ve*Ws*C*b/(a**2 + b**2) Ic=Ve*Ws*C*a/(a**2 + b**2)"»
  «text (7750,-550) 1 7 0 0x1000000 -1 -1 "ï»¿.param Vs=Ve*a/(a**2 + b**2) Vc=-Ve*b/(a**2 + b**2) Vcf=pi*Ip*Re/4"»
  «text (7750,-900) 1 7 0 0x1000000 -1 -1 "ï»¿.param Ip=sqrt(Is**2 + Ic**2) Vo=2*rc1*Ip/pi + rc1*Vcf/rc Ig=(2*Is/pi)*sin(pi*D/2)"»
  «text (-2300,2850) 2 7 1 0x1000000 -1 -1 "ï»¿.CONVERTER'S DESIGN PARAMETERS"»
